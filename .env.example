# Copy this template to backend/.env for local development.
# Production deployments should provide environment variables through the host.
# A legacy repository-root .env remains supported for existing local setups.
# ─── Server ───────────────────────────────────────────────
# FIX E-1: set to production before deploying — stack traces are exposed in development
NODE_ENV=production
PORT=4000

# ─── MongoDB ──────────────────────────────────────────────
# Required. Use MongoDB Atlas in production (never expose to 0.0.0.0 without auth).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/off-by-one?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────
# REQUIRED. In production, each secret must be at least 32 characters, high-entropy,
# free of placeholders/repeated patterns, and different from the other secret.
# Generate each value independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX
REFRESH_TOKEN_EXPIRES_IN=30d

# ─── Image uploads (Cloudinary) ───────────────────────────
# Required in production. API secret MUST stay server-side only — never in frontend code.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Nodemailer / SMTP) ────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="Off By One <noreply@example.com>"

# ─── Frontend ─────────────────────────────────────────────
# Required. The exact origin of the deployed frontend — no trailing slash.
FRONTEND_URL=https://your-app.vercel.app

# Optional Google OAuth. The /api/auth/google endpoint fails closed when absent.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# ─── Rate limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Rewards ──────────────────────────────────────────────
REWARD_POST_APPROVED=50
REWARD_COMMENT=5
REWARD_LIKE_RECEIVED=2
REWARD_DAILY_CAP=200
